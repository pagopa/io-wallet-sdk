{
  "name": "@pagopa/io-wallet-eudi-trust",
  "version": "1.5.8",
  "description": "EUDI Wallet trust evaluation: Lists of Trusted Entities (ETSI TS 119 602) validation, Trust Anchor retrieval, X.509 certificate chain validation and JWS signature validation",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/pagopa/io-wallet-sdk/tree/main/packages/eudi-trust",
  "repository": {
    "type": "git",
    "url": "https://github.com/pagopa/io-wallet-sdk",
    "directory": "packages/eudi-trust"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap",
    "test": "vitest"
  },
  "dependencies": {
    "@pagopa/io-wallet-utils": "workspace:*",
    "zod": "catalog:"
  }
}
